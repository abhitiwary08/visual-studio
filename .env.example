# Copy this file to .env and fill in what you have. Nothing here is required to open the
# dashboard; the Setup page shows what is missing.

# Writes the Hindi scripts (https://console.anthropic.com). Without it, paste your own script JSON.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Free stock footage (https://www.pexels.com/api/). Without it, scenes use plain gradient backgrounds.
PEXELS_API_KEY=

# Printed on thumbnails (optional)
CHANNEL_NAME=

# Hindi voice: hi-IN-MadhurNeural (male) or hi-IN-SwaraNeural (female). Negative rate = slower.
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=-8%
TTS_PITCH=+0Hz

# ffmpeg speed/quality trade-off: ultrafast, veryfast, fast, medium, slow
X264_PRESET=medium

# YouTube defaults
YT_DEFAULT_PRIVACY=private
YT_CATEGORY_ID=27

# Voice engine: "edge" (free, no published commercial terms) or "sarvam" (Sarvam AI Bulbul,
# paid, commercial terms; https://www.sarvam.ai). Recording scenes in your own voice works with both.
TTS_ENGINE=edge
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
# bulbul:v3 speakers include shubh, aditya, rahul, anand (male) and ritu, priya, neha, kavya (female)
SARVAM_SPEAKER=shubh

# Uploads allowed per 24 hours before the dashboard asks you to confirm (0 = no limit).
# Spacing uploads out avoids looking like a mass-production channel.
MAX_UPLOADS_PER_DAY=2

# AI writer. Choose it on the Setup page (saved to config/llm.json), or set LLM_PROVIDER here:
# anthropic, gemini, groq or openai. Keys entered on the Setup page are written to .env.
# LLM_PROVIDER=anthropic
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# AWS Bedrock (LLM_PROVIDER=bedrock): create a Bedrock API key in the AWS console and enable model access.
AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1
# BEDROCK_MODEL=us.amazon.nova-pro-v1:0
# OPENAI_MODEL=gpt-5-mini

# Facebook / Instagram: connect on the Setup page (stored in config/meta_token.json, never commit it).
# META_GRAPH_VERSION=v25.0

# Voice engines: TTS_ENGINE=edge|sarvam|gemini|elevenlabs (also settable on the Setup page)
# GEMINI_TTS_VOICE=Kore
# GEMINI_TTS_STYLE=Read this in clear, natural Hindi, in a calm, warm storyteller voice
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Music generation: MUSIC_PROVIDER=elevenlabs|stability
STABILITY_API_KEY=
